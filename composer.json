{
    "name": "polar/events",
    "description": "A WordPress plugin to manage events",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Victor Guerrero",
            "email": "victorg@hey.com"
        }
    ],
    "require": {
        "nesbot/carbon": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Polar\\Events\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Polar\\Events\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-name": "polar-events"
    }
}
